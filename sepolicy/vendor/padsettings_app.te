# Allow padsettings_app to find hal_peripherals_hwservice
hal_client_domain(padsettings_app, hal_peripherals)

# Allow padsettings_app to read sysfs_keyboard_status
allow padsettings_app sysfs_keyboard_status:file r_file_perms;
# Allow padsettings_app to read the USB mode node
allow padsettings_app sysfs_usb_mode:file r_file_perms;
